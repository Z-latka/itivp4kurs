PORT=3000

# MongoDB Atlas (Connect -> Drivers -> строка подключения):
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=MindCare
# Локальная установка MongoDB Community Edition:
# MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=mindcare
# Если при подключении к Atlas ошибка "querySrv ETIMEOUT" — раскомментируйте:
# MONGO_DNS=8.8.8.8,1.1.1.1

JWT_SECRET=замените_на_длинную_случайную_строку
JWT_EXPIRES_IN=12h
