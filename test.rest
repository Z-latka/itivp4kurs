@baseUrl = http://localhost:3000/api
# Токены берутся из ответов /auth/login (поле token)
@userToken = <вставьте token клиента>
@adminToken = <вставьте token администратора>
@consultationId = <_id консультации из GET /consultations>
@bookingId = <_id записи>
@questionId = <_id обращения>
@reviewId = <_id отзыва>

### Регистрация клиента (роль всегда user)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "Password123!",
  "nickname": "Тихий Лис"
}

### Вход клиента
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "demo@mindcare.by",
  "password": "Demo123!"
}

### Вход администратора (психолога), создаётся сидером
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@mindcare.by",
  "password": "Admin123!"
}

### Профиль без токена -> 401
GET {{baseUrl}}/auth/profile

### Профиль
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{userToken}}

### Смена псевдонима
PUT {{baseUrl}}/auth/profile
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "nickname": "Ночная Сова"
}

### Неверный пароль
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "WrongPassword!"
}

### ===== Консультации =====
GET {{baseUrl}}/consultations

###
GET {{baseUrl}}/consultations/{{consultationId}}

### Создание (только admin)
POST {{baseUrl}}/consultations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "topic": "Депрессия",
  "description": "Работа с депрессивными состояниями",
  "duration": 90,
  "price": 120,
  "specialist": "Анна Ковалёва"
}

### Обновление (только admin)
PUT {{baseUrl}}/consultations/{{consultationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "topic": "Тревожность (обновлено)",
  "description": "Новое описание: углубленная работа",
  "duration": 75,
  "status": "busy"
}

### Удаление (только admin)
DELETE {{baseUrl}}/consultations/{{consultationId}}
Authorization: Bearer {{adminToken}}

### Отзыв
POST {{baseUrl}}/consultations/{{consultationId}}/reviews
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "rating": 5,
  "comment": "Очень помогло"
}

### ===== Записи =====
POST {{baseUrl}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "consultationId": "{{consultationId}}",
  "scheduledAt": "2027-01-15T10:00:00Z",
  "format": "video",
  "comment": "Хочу разобраться с тревогой"
}

###
GET {{baseUrl}}/bookings/my
Authorization: Bearer {{userToken}}

###
PATCH {{baseUrl}}/bookings/{{bookingId}}/cancel
Authorization: Bearer {{userToken}}

### Все записи (admin)
GET {{baseUrl}}/bookings
Authorization: Bearer {{adminToken}}

###
PATCH {{baseUrl}}/bookings/{{bookingId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "confirmed"
}

### ===== Тесты =====
GET {{baseUrl}}/tests

###
GET {{baseUrl}}/tests/anxiety

### Гость: результат без сохранения
POST {{baseUrl}}/tests/anxiety/submit
Content-Type: application/json

{
  "answers": [1, 2, 1, 0, 1, 2, 1]
}

### Авторизованный: результат сохраняется
POST {{baseUrl}}/tests/anxiety/submit
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "answers": [1, 2, 1, 0, 1, 2, 1]
}

###
GET {{baseUrl}}/tests/results/my
Authorization: Bearer {{userToken}}

### ===== Анонимные обращения =====
POST {{baseUrl}}/questions
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "topic": "Не могу уснуть",
  "text": "Уже неделю сплю по 4 часа, мысли не дают покоя"
}

###
GET {{baseUrl}}/questions/my
Authorization: Bearer {{userToken}}

### Ответ психолога
POST {{baseUrl}}/questions/{{questionId}}/messages
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "text": "Здравствуйте! Давайте разберёмся вместе."
}

###
GET {{baseUrl}}/questions
Authorization: Bearer {{adminToken}}

###
PATCH {{baseUrl}}/questions/{{questionId}}/close
Authorization: Bearer {{userToken}}

###
GET {{baseUrl}}/stats

### ===== MongoDB: вложенные массивы =====
### Изменение элемента массива (позиционный $)
PATCH {{baseUrl}}/consultations/{{consultationId}}/reviews/{{reviewId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "rating": 4
}

### $addToSet тегов
POST {{baseUrl}}/consultations/{{consultationId}}/tags
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "tags": ["тревога", "экзамены"]
}

### Поиск по элементу массива
GET {{baseUrl}}/consultations?tag=тревога

### Aggregation pipeline
GET {{baseUrl}}/consultations/stats/tags
